# ==========================
# LLM Provider (Groq)
# ==========================

LLM_PROVIDER=groq

GROQ_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1

GROQ_MODEL=llama-3.3-70b-versatile

# ==========================
# Global LLM Settings
# ==========================

LLM_TEMPERATURE=0.7

LLM_MAX_TOKENS=256

LLM_TIMEOUT=30

ENABLE_CIRCUIT_BREAKER=true

# ==========================
# Context Relevance Engine
# ==========================

MEMORY_RELEVANCE_THRESHOLD=0.55
CONVERSATION_RELEVANCE_THRESHOLD=0.40
SEARCH_RELEVANCE_THRESHOLD=0.55
MAX_MEMORY_ENTRIES=5
MAX_CONVERSATION_ENTRIES=3
MAX_SEARCH_RESULTS=5

# ==========================
# Embeddings
# ==========================

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ==========================
# ChromaDB
# ==========================

CHROMA_DB_PATH=./database/chroma

# ==========================
# Database
# ==========================

DATABASE_URL=sqlite:///./database/aetheris.db

# ==========================
# External Knowledge (Tavily)
# ==========================

TAVILY_API_KEY=

# ==========================
# Security
# ==========================

SECRET_KEY=

# ==========================
# Logging
# ==========================

LOG_LEVEL=INFO
